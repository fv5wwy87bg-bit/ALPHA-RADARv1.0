# Universe: between 1 and 200 highest-volume eligible pairs (default 100)
MAX_SYMBOLS=100
MIN_24H_QUOTE_VOLUME=10000000
WORKERS=8
SCAN_INTERVAL_SECONDS=600
ALERT_SCORE=65

# Optional Telegram alerts. Leave blank to print results only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local state file for comparing open interest between scans
STATE_FILE=radar_state.json
RADAR_DB=radar_history.sqlite3
LOG_LEVEL=INFO
